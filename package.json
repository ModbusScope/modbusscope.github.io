{
  "name": "modbusscope-site",
  "private": true,
  "scripts": {
    "build": "eleventy",
    "lint": "npm run lint:html && npm run lint:css",
    "lint:html": "npm run build && html-validate _site/index.html _site/features/index.html _site/pricing/index.html _site/downloads/index.html",
    "lint:css": "stylelint src/styles.css",
    "start": "eleventy --serve --port=8080",
    "test:links": "linkinator http://localhost:8080/ http://localhost:8080/features/ http://localhost:8080/pricing/ http://localhost:8080/downloads/ --recurse --skip \"^(?!http://localhost)\"",
    "test:e2e": "playwright test",
    "test": "start-server-and-test start http://localhost:8080 \"npm run test:links && npm run test:e2e\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.2",
    "@playwright/test": "^1.62.1",
    "html-validate": "^11.6.2",
    "linkinator": "^8.0.3",
    "start-server-and-test": "^3.0.12",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0"
  }
}
